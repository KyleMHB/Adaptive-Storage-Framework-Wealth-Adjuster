    <AsfPath Condition="'$(AsfPath)' == ''">E:\Steam\steamapps\workshop\content\294100\3033901359\1.6\Assemblies\AdaptiveStorageFramework.dll</AsfPath>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
